# Copy this file to .env.local (git-ignored) for local overrides.
# Vite only inlines vars prefixed with VITE_ — see https://vite.dev/guide/env-and-mode

# Optional. GA4 Measurement ID, format G-XXXXXXXXXX.
# Leave unset to disable analytics entirely (the default for local dev) — no
# script is injected, no network request is made. In CI/deploy, this is
# sourced from the VITE_GA_MEASUREMENT_ID GitHub Actions repository *variable*
# (not a secret — GA4 Measurement IDs are public, visible in any deployed
# site's source). See .github/workflows/deploy.yml and src/lib/analytics.ts.
VITE_GA_MEASUREMENT_ID=
